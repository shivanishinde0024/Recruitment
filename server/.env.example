NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

DATABASE_URL="mysql://portal_user:portal_password@localhost:3306/recruitment"

JWT_ACCESS_SECRET=your_jwt_access_secret_min_64_characters_placeholder_key_must_change
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_64_characters_placeholder_key_must_change
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=placeholder_smtp_password
MAIL_FROM="Recruitment Portal <no-reply@example.com>"

UPLOAD_DIR=./uploads
MAX_RESUME_MB=5
MAX_DOC_MB=5
ALLOWED_RESUME_TYPES=pdf,doc,docx
