{
  "name": "recruitment-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Recruitment Portal with Next.js, Bootstrap 5, Express, MySQL, and Prisma",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "test": "npm run test:server",
    "lint:server": "npm --prefix server run lint",
    "lint:client": "npm --prefix client run lint",
    "lint": "npm run lint:server && npm run lint:client",
    "seed": "npm --prefix server run seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
